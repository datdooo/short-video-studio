# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
# Only reviewed, portable project skills are versioned; other agent state stays local.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/smart-auto-cut/
!/.agents/skills/release-candidate/
/.agents/skills/smart-auto-cut/*
/.agents/skills/release-candidate/*
!/.agents/skills/smart-auto-cut/SKILL.md
!/.agents/skills/release-candidate/SKILL.md
/.codex/
/outputs/
/release/
/work/
/.local-tools/
/worker-data/
cookies.txt
*.cookies.txt
youtube-download.json
*.dpapi
chatgpt-credentials.json

node_modules/
.next/
.env
.env.local
.DS_Store
dist/

/.isolation-verification/
