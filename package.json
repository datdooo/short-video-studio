{
  "name": "shortcut-studio",
  "version": "1.1.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "youtube:cookies": "node scripts/configure-youtube-cookies.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node dist/standalone/server.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "setup:media": "node scripts/setup-media-tools.mjs",
    "worker": "node worker/server.mjs",
    "personal": "node scripts/personal-dev.mjs",
    "install:antigravity": "node scripts/install-antigravity.mjs",
    "package:mac": "node scripts/package-macos.mjs --beta",
    "setup:macos26": "node scripts/setup-macos26-runtime.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:isolation": "node --test desktop/runtime-config.test.mjs worker/chatgpt-store.test.mjs",
    "package:mac:beta": "node scripts/package-macos.mjs --beta",
    "personal:beta": "node scripts/personal-dev.mjs",
    "test": "node --test lib/*.test.mjs worker/*.test.mjs desktop/*.test.mjs"
  },
  "dependencies": {
    "@ozymandiasthegreat/vad": "2.0.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "youtubei.js": "^18.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
